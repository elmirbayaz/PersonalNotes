<Window x:Class="PersonalNotes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Personal Notes"
        Width="1280"
        Height="760"
        MinWidth="900"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Background" Value="#353535"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4A4A4A"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
        Background="#282828"
        BorderBrush="#3C3C3C"
        BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                   Text="Personal Notes"
                   Foreground="White"
                   FontSize="18"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
                    <Button Content="+ Новая заметка"
                    Command="{Binding CreateNoteCommand}"/>
                    <Button Content="+ Новая папка"
                    Command="{Binding CreateFolderCommand}"/>
                    <Button Content="Импорт"
                            Command="{Binding ImportNotesCommand}"/>
                    <ComboBox Width="175"
                      Margin="8,4"
                      SelectedValue="{Binding SelectedSortOption}"
                      SelectedValuePath="Content">
                        <ComboBoxItem Content="По дате изменения"/>
                        <ComboBoxItem Content="По дате создания"/>
                        <ComboBoxItem Content="По названию"/>
                    </ComboBox>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Панель папок -->
            <Border Grid.Column="0"
                    Background="#252525"
                    BorderBrush="#3C3C3C"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="10">

                    <TextBlock Text="ПАПКИ"
                               Foreground="#BDBDBD"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Top"
                               Margin="4,4,4,12"/>

                    <Button Content="Глобальная папка"
                            DockPanel.Dock="Top"
                            HorizontalAlignment="Stretch"
                            Command="{Binding ShowGlobalFolderCommand}"/>

                    <StackPanel DockPanel.Dock="Bottom"
                                Width="250">
                        <TextBox Text="{Binding FolderName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Padding="8"
                                 Margin="0,10,0,4"
                                 Background="#3A3A3A"
                                 Foreground="White"
                                 BorderBrush="#555555"/>

                        <StackPanel>
                            <Button Content="Создать папку"
                                    Width="242"
                                    Command="{Binding CreateFolderCommand}"/>

                            <Button Content="Переименовать папку"
                                    Width="242"
                                    Command="{Binding RenameFolderCommand}"/>
                        </StackPanel>

                        <Button Content="Удалить папку"
                                Width="242"
                                Command="{Binding DeleteFolderCommand}"/>
                    </StackPanel>

                    <ListBox ItemsSource="{Binding Folders}"
                             SelectedItem="{Binding SelectedFolder}"
                             Width="250"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           Padding="6"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Список заметок -->
            <Border Grid.Column="1" Background="#2B2B2B" BorderBrush="#3C3C3C" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <TextBox DockPanel.Dock="Top"
                             Height="32"
                             Margin="0,0,0,12"
                             Padding="8"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Поиск по заголовку и тексту заметок"
                             Background="#3A3A3A"
                             Foreground="White"
                             BorderBrush="#555555"/>

                    <TextBlock Text="ЗАМЕТКИ"
                               DockPanel.Dock="Top"
                               Foreground="#BDBDBD"
                               FontWeight="SemiBold"
                               Margin="2,0,2,8"/>

                    <ListBox ItemsSource="{Binding Notes}"
                             SelectedItem="{Binding SelectedNote}"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8" Margin="0,2" Background="#353535">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat='Изменено: {0:dd.MM.yyyy HH:mm}'}"
                                                   Foreground="#BDBDBD"
                                                   FontSize="11"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Редактор заметки -->
            <Grid Grid.Column="2" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="{Binding SelectedNote.Folder.Name,
                      StringFormat='Расположение: {0}',
                      TargetNullValue=Расположение: Глобальная папка}"
               Foreground="#AFAFAF"
               FontSize="13"/>

                    <StackPanel Orientation="Horizontal"
                Margin="0,8,0,0">
                        <TextBox Width="160"
                 Height="28"
                 Padding="6"
                 Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}"
                 Background="#3A3A3A"
                 Foreground="White"
                 BorderBrush="#555555"/>

                        <Button Content="+ Тег"
                Command="{Binding AddTagCommand}"/>

                        <ItemsControl ItemsSource="{Binding SelectedNoteTags}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>

                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#3A3A3A"
                            CornerRadius="4"
                            Margin="4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}"
                                       Foreground="White"
                                       Margin="8,4"/>

                                            <Button Content="×"
                                    Padding="4,0"
                                    Command="{Binding DataContext.RemoveTagCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,18,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Text="{Binding SelectedNote.Title, UpdateSourceTrigger=PropertyChanged}"
                             Background="Transparent"
                             Foreground="White"
                             BorderThickness="0"
                             FontSize="26"
                             FontWeight="SemiBold"
                             VerticalContentAlignment="Center"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal">
                        <Button Content="Сохранить"
                                Command="{Binding SaveNoteCommand}"/>
                        <Button Content="Экспорт"
                                Command="{Binding ExportNoteCommand}"/>
                        <Button Content="Удалить"
                                Command="{Binding DeleteNoteCommand}"/>
                    </StackPanel>
                </Grid>

                <TextBox Grid.Row="2"
                         Text="{Binding SelectedNote.Content, UpdateSourceTrigger=PropertyChanged}"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         VerticalScrollBarVisibility="Auto"
                         Padding="12"
                         Background="#252525"
                         Foreground="White"
                         BorderBrush="#454545"/>

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            Margin="0,14,0,0">
                    <TextBlock Text="{Binding SelectedNote.CreatedAt, StringFormat='Создано: {0:dd.MM.yyyy HH:mm}'}"
                               Foreground="#AFAFAF"
                               FontSize="12"/>

                    <TextBlock Text="{Binding SelectedNote.UpdatedAt, StringFormat='   Изменено: {0:dd.MM.yyyy HH:mm}'}"
                               Foreground="#AFAFAF"
                               FontSize="12"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>